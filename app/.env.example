# Copy to .env and fill in. EXPO_PUBLIC_ values are bundled into the app, so never put secrets like API keys here.

# NILNA Events server URL (see /server). Leave empty to run the app fully offline.
EXPO_PUBLIC_API_URL=

# PIN that unlocks the staff dashboard on a device.
EXPO_PUBLIC_STAFF_PIN=2026

# Must match STAFF_KEY on the server. Only set this in the staff build of the app.
EXPO_PUBLIC_STAFF_KEY=
